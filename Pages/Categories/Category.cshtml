@page
@model Razor.Pages.Categories.CategoryModel

<div class="container">
     <div class="row">
         <div class="col-12">
             <h1>List of Categories</h1>
             <div class="col-6">
                 <a asp-page="create" class="btn-primary">Create </a>
             </div>
         </div>
     </div>
     <div class="row">
         <div class="col-12">
             <table class="d-lg-table table-bordered table-striped">
                 <thead>
                     <tr>
                         <th>Id</th>
                         <th>Category name</th>
                     </tr>
                 </thead>
                 <tbody>
                    @foreach (var item in Model.Categories)
                    {
                       <tr>
                           <td>@item.Id</td>
                           <td>
                               @item.Name
                           </td>
                       </tr>
                    }
                </tbody>
             </table>
         </div>
     </div>
</div>